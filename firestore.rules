rules_version = '2';

// Bu dosyayı Firebase Console > Firestore Database > Rules sekmesine
// yapıştırıp "Yayınla" (Publish) demen yeterli — komut satırı gerekmez.
//
// ÖNEMLİ - GÜVENLİK SEVİYESİ: Bu kurallar "giriş yapmış (anonim dahil)
// herkes okuyup yazabilir" seviyesindedir. Küçük, güvenilir bir köy
// topluluğu için yeterli bir başlangıç noktasıdır ama gerçek bir
// yetkilendirme (ör. sadece admin unvan değiştirebilsin) sunucu tarafı
// doğrulama (Cloud Functions) gerektirir — bu, ileride eklenebilecek bir
// sertleştirme adımıdır.
service cloud.firestore {
  match /databases/{database}/documents {
    match /kullanicilar/{userId} {
      allow read, write: if request.auth != null;
    }
    match /gonderiler/{postId} {
      allow read, write: if request.auth != null;
    }
    match /yorumlar/{commentId} {
      allow read, write: if request.auth != null;
    }
  }
}
